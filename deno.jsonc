{
  "//": "EmberEngine (TypeScript) - workspace config. Deno is the single toolchain: runtime, test runner, bundler and .exe compiler.",
  "version": "0.1.0",
  "name": "@ember/workspace",
  "exports": "./packages/core/mod.ts",
  "lock": false,
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.16",
    "@ember/assets": "./packages/assets/mod.ts",
    "@ember/gameloader": "./packages/gameloader/mod.ts",
    "@ember/core": "./packages/core/mod.ts",
    "@ember/render2d": "./packages/render2d/mod.ts",
    "@ember/render3d": "./packages/render3d/mod.ts",
    "@ember/runtime": "./packages/runtime/mod.ts",
    "@ember/editor": "./packages/editor/mod.ts",
    "@ember/packager": "./packages/packager/mod.ts",
    "@ember/cli": "./packages/cli/mod.ts",
    "@ember/player": "./packages/player/mod.ts",
    "@ember/player/app/bootstrap": "./packages/player/app/bootstrap.ts",
    "@ember/player/app/host": "./packages/player/app/host.ts",
    "@ember/player/app/canvas-factory": "./packages/player/app/canvas-factory.ts",
    "@ember/studio": "./packages/studio/mod.ts",
    "@ember/mcp": "./packages/mcp/mod.ts"
  },
  "tasks": {
    "ember": "deno run -A --unstable-ffi packages/cli/main.ts",
    "editor": "deno run -A --unstable-ffi packages/editor/main.ts",
    "editor:native": "deno run -A --unstable-ffi packages/editor/main.ts",
    "studio": "deno run -A packages/cli/main.ts studio games/ember-runner",
    "//build:editor": "--allow-run is required: the editor's Export action shells out to `deno bundle` and `deno compile`.",
    "build:editor": "deno compile --unstable-ffi --allow-ffi --allow-read --allow-write --allow-env --allow-run --icon assets/emberengine.ico --output dist/EmberEngine.exe packages/editor/main.ts",
    "mcp": "deno run -A --unstable-ffi packages/mcp/main.ts",
    "build:mcp": "deno compile --unstable-ffi --allow-ffi --allow-read --allow-write --allow-env --allow-run --icon assets/emberengine.ico --output dist/EmberMCP.exe packages/mcp/main.ts",
    "play": "deno run -A packages/cli/main.ts play games/ember-runner",
    "export": "deno run -A packages/cli/main.ts export games/ember-runner",
    "test": "deno test -A tests/",
    "test:unit": "deno test -A tests/unit/",
    "test:game": "deno test -A tests/game/",
    "test:integration": "deno test -A tests/integration/",
    "test:report": "deno run -A tools/test-report.ts",
    "check": "deno check packages/cli/main.ts packages/editor/main.ts packages/mcp/main.ts",
    "fmt": "deno fmt packages tests games tools",
    "lint": "deno lint packages tests games tools"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["legacy", "build", "dist"]
  },
  "lint": {
    "exclude": ["legacy", "build", "dist"]
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": false,
    "lib": ["deno.window", "dom", "dom.iterable", "dom.asynciterable"]
  }
}
